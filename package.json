{
  "name": "@crucibledx/forge-cli",
  "version": "0.6.22",
  "description": "AI development environment setup & config sync CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "forge": "./bin/forge.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "tsconfig.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crucibledx/forge-cli.git"
  },
  "homepage": "https://github.com/crucibledx/forge-cli#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "build": "bun build src/main.ts --compile --outfile dist/forge && bun run clean",
    "clean": "find . -maxdepth 1 -name '*.bun-build' -delete",
    "test:unit": "bun test src/",
    "test:e2e": "bun test e2e/",
    "test": "bun test src/ e2e/",
    "format": "prettier --write src/ e2e/",
    "format:check": "prettier --check src/ e2e/",
    "lint": "eslint src/ e2e/",
    "lint:fix": "eslint src/ e2e/ --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.3.0",
    "lodash-es": "^4.17.21",
    "strip-ansi": "^7.1.0",
    "commander": "^14.0.3",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^25.6.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1"
  }
}
